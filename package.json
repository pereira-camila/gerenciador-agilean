{
  "name": "gerenciador-agilean",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "cypress open",
    "clean:reports": "rimraf reports",
    "cy:run": "cypress run",
    "merge:reports": "mochawesome-merge \"reports/json/*.json\" -o reports/report.json",
    "generate:report": "marge reports/report.json --reportDir reports/html --reportFilename index --reportTitle \"Relatório de Execução - Gerenciador de Atividades\" --reportPageTitle \"Gerenciador de Atividades - Automação de Testes\" --inline",
    "test:run": "npm run clean:reports && npm run cy:run",
    "report": "npm run merge:reports && npm run generate:report",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pereira-camila/gerenciador-agilean.git"
  },
