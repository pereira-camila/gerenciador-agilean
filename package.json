  "type": "module",
  "bugs": {
    "url": "https://github.com/pereira-camila/gerenciador-agilean/issues"
  },
  "homepage": "https://github.com/pereira-camila/gerenciador-agilean#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.0",
    "cypress": "^15.21.1",
    "dotenv": "^17.4.2",
    "mochawesome": "^8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "typescript": "^7.0.2"
  }
